{
  "name": "spectrify",
  "version": "1.0.0",
  "description": "Spectrify | Music Player | Audio Visualiser",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js",
    "build": "next build",
    "start": "next build && NODE_ENV=production ENV=production node server.js",
    "start:stage": "next build && NODE_ENV=production ENV=stage node server.js",
    "storybook": "start-storybook -p 5000",
    "analyze": "BUNDLE_ANALYZE=both next build",
    "analyze:server": "BUNDLE_ANALYZE=server next build",
    "analyze:browser": "BUNDLE_ANALYZE=browser next build",
    "analyze:size": "next build && cat .next/stats.txt",
    "pretty": "prettier --single-quote --tab-width 2 --write \"**/*.{js,css,json}\"",
    "precommit": "lint-staged"
  },
  "lint-staged": {
    "**/*.{js,css,json}": [
      "npm run pretty",
      "git add"
    ]
  },
  "keywords": [
    "nextjs",
    "tailwindcss",
    "styled components",
    "reactjs",
    "pwa",
    "redux",
    "seo",
    "critical css",
    "workbox"
  ],
  "author": "SNS",
  "license": "ISC",
  "dependencies": {
    "@zeit/next-css": "^1.0.1",
    "axios": "^1.7.7",
    "babel-plugin-macros": "^3.1.0",
    "compression": "^1.7.5",
    "express": "^4.21.1",
    "lodash": "^4.17.21",
    "next": "^15.0.2",
    "next-redux-wrapper": "^8.1.0",
    "nookies": "^2.5.2",
    "postcss-easy-import": "^4.0.0",
    "react": "^18.3.1",
    "react-audio-player": "^0.17.0",
    "react-audio-spectrum": "^0.1.5",
    "react-dom": "^18.3.1",
    "react-player": "^2.16.0",
    "react-progressive-graceful-image": "^0.7.0",
    "react-redux": "^9.1.2",
    "redux": "^5.0.1",
    "redux-promise-middleware": "^6.2.0",
    "redux-thunk": "^3.1.0",
    "screenfull": "^6.0.2",
    "styled-components": "^6.1.13",
    "tailwindcss": "^3.4.14",
    "twin.macro": "^3.4.1",
    "type-to-reducer": "^1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@fullhuman/postcss-purgecss": "^6.0.0",
    "@storybook/addon-storysource": "^8.4.1",
    "@storybook/react": "^8.4.1",
    "@zeit/next-bundle-analyzer": "^0.1.2",
    "autoprefixer": "^10.4.20",
    "babel-eslint": "^10.1.0",
    "babel-loader": "^9.2.1",
    "babel-plugin-styled-components": "^2.1.4",
    "babel-plugin-tailwind-components": "^0.5.10",
    "copy-webpack-plugin": "^12.0.2",
    "cssnano": "^7.0.6",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "postcss-loader": "^8.1.1",
    "postcss-preset-env": "^10.0.8",
    "prettier": "^3.3.3",
    "redux-logger": "^3.0.6",
    "webpack-bundle-size-analyzer": "^3.1.0"
  }
}
